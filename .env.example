# Chakravyuh — AI-Powered Fraud Intelligence System
# Copy this file to .env and fill in your values. Never commit .env to version control.

# ------------------------------------------------------------
# OpenAI (required for alert explanation & report narration)
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------
# PostgreSQL (optional — app falls back to in-memory store if DB_PASSWORD is unset)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ------------------------------------------------------------
# API Server
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------------
# Frontend (local dev only — in production Render handles this)
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------
# Next.js Frontend (apps/web/.env.local — local dev only)
# In production on Render, leave this UNSET so the browser uses
# Next.js rewrite proxy → no CORS, no public API URL needed.
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

