# Chakravyuh — AI-Powered Fraud Intelligence System
# Copy this file to .env and fill in your values. Never commit .env to version control.

# ------------------------------------------------------------
# OpenAI (required for alert explanation & report narration)
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# PostgreSQL (optional — app falls back to JSON mock data if DB_PASSWORD is unset)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ------------------------------------------------------------
# API Server
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------------
# Frontend CORS origin
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
